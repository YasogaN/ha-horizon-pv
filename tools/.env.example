# Copy this file to .env and fill in your local values.
# .env is ignored by git.

# Historical data range used for scraping and dataset creation.
START_DATE=2024-08-01
END_DATE=2026-05-24
ML_START_DATE=2024-08-01
ML_END_DATE=2026-05-24

# Location of the PV system.
LOCATION_NAME=
LATITUDE=
LONGITUDE=
ELEVATION=
TIMEZONE=Europe/Vienna

# PV system geometry.
PV_PANEL_AZIMUTH_DEG=350
PV_PANEL_TILT_DEG=45
PV_OBSERVED_PEAK_W=

# SunnyPortal access for historical PV data scraping.
SUNNYPORTAL_EMAIL=
SUNNYPORTAL_PASSWORD=
SUNNYPORTAL_LOGIN_URL=https://www.sunnyportal.com/FixedPages/HoManEnergyRedesign.aspx

# Open-Meteo secondary forecast model used for training features.
WEATHER_SECONDARY_FORECAST_MODEL=icon_eu

# Optional local output paths. Defaults already point into tools/data and tools/models.
DATA_DIR=./data
MODEL_DIR=./models/pv_forecast_xgboost

# XGBoost training settings.
XGB_OBJECTIVE=reg:squarederror
XGB_N_ESTIMATORS=2000
XGB_MAX_DEPTH=9
XGB_LEARNING_RATE=0.04
XGB_SUBSAMPLE=0.9
XGB_COLSAMPLE_BYTREE=0.85
XGB_MIN_CHILD_WEIGHT=1
XGB_REG_LAMBDA=1.5
XGB_RANDOM_STATE=42
XGB_N_JOBS=-1

# Feature engineering settings.
USE_NEIGHBOR_FEATURES=true
USE_NEIGHBOR_DELTAS=true
NEIGHBOR_OFFSETS=-4,-2,-1,1,2,4
ACTIVE_PV_THRESHOLD_W=200
SAFE_PREDICTION_FACTOR=0.90
SAVE_FEATURE_IMPORTANCE=true
